# ============================================================
#  .env.example — ตัวอย่างไฟล์ตั้งค่า Scalp Scanner
#  วิธีใช้: คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น ".env" จากนั้นแก้ค่าตามต้องการ
#  (อ่านวิธีขอ LINE Token / Group ID แบบละเอียดในไฟล์ README.md)
# ============================================================

# ---------- LINE (จำเป็นต้องกรอก ไม่งั้นโปรแกรมจะไม่ยอมเริ่มทำงาน) ----------
# โทเคนสำหรับส่งข้อความผ่าน LINE Messaging API
# ไปเอาได้จาก https://developers.line.biz/console/ > เลือก Provider > Channel ของคุณ
# > แท็บ "Messaging API" > หัวข้อ "Channel access token" > กด Issue
LINE_CHANNEL_ACCESS_TOKEN=

# ID ของกลุ่ม LINE หรือผู้ใช้ที่จะรับการแจ้งเตือน (ขึ้นต้นด้วย C... สำหรับกลุ่ม หรือ U... สำหรับผู้ใช้เดี่ยว)
LINE_TARGET_ID=

# ---------- แหล่งข้อมูลราคา ----------
# ผู้ให้บริการข้อมูลหลัก: yahoo (ฟรี ไม่ต้องขอ key) / finnhub / alpaca
# ถ้าตั้งเป็น finnhub หรือ alpaca แล้วดึงข้อมูลไม่สำเร็จ โปรแกรมจะสลับไปใช้ Yahoo ให้อัตโนมัติ
PROVIDER=yahoo

# API Key ของ Finnhub (ใช้เมื่อ PROVIDER=finnhub) — ขอฟรีได้ที่ https://finnhub.io

# API Key/Secret ของ Alpaca (ใช้เมื่อ PROVIDER=alpaca) — ขอได้ที่ https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ถ้าราคาล่าสุด (quote) เก่ากว่ากี่วินาที ให้ถือว่า "เก่าเกินไป" ไม่นำมาใช้ตัดสินใจ
MAX_QUOTE_STALE_SEC=90

# "เย็บ" แท่งเทียนล่าสุดด้วยราคาปัจจุบันหรือไม่ (true = ทำให้แท่งล่าสุดสดขึ้น แม่นยำขึ้นตอนตลาดกำลังวิ่ง)
STITCH_LAST_BAR=true

# ---------- การคัดเลือกหุ้น (universe) ----------
# รายชื่อ screener ของ Yahoo ที่จะใช้หาหุ้น (คั่นด้วยจุลภาค) เช่น day_gainers, most_actives
SCREENERS=day_gainers,most_actives

# หุ้นที่ต้องการให้สแกนเพิ่มเติมเสมอ นอกเหนือจาก screener (คั่นด้วยจุลภาค) เช่น AAPL,TSLA
EXTRA_TICKERS=

# จำนวนหุ้นสูงสุดที่จะสแกนต่อรอบ (ยิ่งเยอะยิ่งช้าและเสี่ยงโดนจำกัด rate limit)

# ราคาต่ำสุด/สูงสุดของหุ้นที่จะสแกน (ดอลลาร์)
MIN_PRICE=2
MAX_PRICE=1000

# วอลุ่มเฉลี่ยต่อวันขั้นต่ำ (กรองหุ้นที่ซื้อขายเบาบางออก)
MIN_AVG_VOLUME=1000000

# ---------- คุณภาพราคา / สภาพคล่อง ----------
# ส่วนต่างราคาซื้อ-ขาย (bid/ask spread) สูงสุดที่ยอมรับได้ (%) ถ้ากว้างกว่านี้จะข้ามหุ้นนั้น
MAX_SPREAD_PCT=0.35

# มูลค่าซื้อขายขั้นต่ำในช่วง 5 นาที (ดอลลาร์) ถ้าต่ำกว่านี้ถือว่าสภาพคล่องไม่พอ
MIN_DOLLAR_VOLUME_5M=500000

# ---------- ความเสี่ยงจากข่าว/การหยุดซื้อขาย ----------
# ข้ามหุ้นที่จะประกาศงบการเงินภายในกี่วันข้างหน้า (ป้องกันความผันผวนจากข่าว)
SKIP_EARNINGS_DAYS=2

# ถ้าแท่งเทียนล่าสุดเก่ากว่ากี่วินาที ให้สงสัยว่าหุ้นถูกหยุดพักการซื้อขาย (halt)
HALT_GAP_SEC=420

# ---------- ตัวชี้วัดทางเทคนิค ----------
# timeframe ที่จะใช้วิเคราะห์ (คั่นด้วยจุลภาค) เช่น 5m,15m
TIMEFRAMES=5m,15m

# ตัวคูณ RVOL ที่ถือว่าวอลุ่ม "พุ่ง" ชัดเจน
VOL_SPIKE=2.0

# ช่วง RSI ที่ถือว่าเป็นโซนดีสำหรับเข้าซื้อ (ต่ำสุด-สูงสุด)
RSI_LOW=50
RSI_HIGH=70

# ระดับ RSI ที่ถือว่า "oversold" (ขายมากเกินไป) สำหรับจับจังหวะเด้งกลับ
RSI_OVERSOLD=35

# จำนวนแท่งย้อนหลังที่ใช้หาแนวต้าน (breakout)
LOOKBACK=20

# คะแนนขั้นต่ำที่จะยอมส่งสัญญาณ (ก่อนปรับตามภาวะตลาด)
MIN_SCORE=70

# ---------- Relative Volume (RVOL) ----------
# จำนวนวันย้อนหลังที่ใช้เทียบ RVOL ตามช่วงเวลาเดียวกัน
RVOL_DAYS=10

# RVOL ขั้นต่ำที่ยอมรับ (เทียบช่วงเวลาเดียวกันของวันก่อนหน้า)
MIN_RVOL_TOD=1.8

# ---------- การบริหารความเสี่ยง / เป้าหมายกำไร ----------
# ตัวคูณ ATR สำหรับตั้งจุดตัดขาดทุน (stop) ยิ่งมากยิ่งให้พื้นที่ราคาแกว่งได้เยอะ

# เป้าหมายกำไรที่ 1 และ 2 เป็นหน่วย R (เท่าของความเสี่ยงต่อหุ้น) เช่น 1.5 = กำไร 1.5 เท่าของความเสี่ยง
ATR_TP1=1.5
ATR_TP2=2.5

# ระยะยืดตัวสูงสุดที่ยอมรับได้ (หน่วยเป็นเท่าของ ATR ห่างจาก VWAP) ถ้ายืดเกินนี้ถือว่าไล่ราคาสูงเกินไป ไม่ส่งสัญญาณ
MAX_EXTENSION=2.5

# บังคับว่าราคาต้องอยู่เหนือ VWAP เท่านั้นถึงจะส่งสัญญาณ (true/false)
REQUIRE_VWAP=true

# ---------- เงินทุน / ขนาดพอร์ต ----------
# เงินทุนทั้งหมดที่ใช้เทรด (ดอลลาร์) — ใช้คำนวณจำนวนหุ้นที่ควรซื้อ
ACCOUNT_SIZE=10000

# เปอร์เซ็นต์ของเงินทุนที่ยอมเสี่ยงต่อ 1 ไม้ (เช่น 1 = เสี่ยง 1% ของเงินทุน)
RISK_PCT=1

# ขาดทุนสะสมสูงสุดต่อวัน (หน่วย R) ถ้าเกินนี้จะหยุดส่งสัญญาณใหม่ทันทีเพื่อป้องกันความเสียหายเพิ่ม
DAILY_LOSS_LIMIT_R=3

# จำนวนไม้ที่เปิดพร้อมกันได้สูงสุด
MAX_OPEN_POSITIONS=4

# จำนวนแจ้งเตือน (alert) สูงสุดต่อวัน กันไม่ให้สแปมแจ้งเตือนเยอะเกินไป
MAX_ALERTS_PER_DAY=25

# ถือไม้นานสูงสุดกี่นาทีก่อนจะบังคับปิด ถ้ายังไม่ได้กำไรตามเป้า (time stop)
TIME_STOP_MIN=45

# ความถี่ในการเช็คว่าไม้ที่เปิดอยู่ควรปิดหรือยัง (วินาที)
EXIT_POLL_SEC=30

# ---------- จังหวะการทำงาน ----------
# ความถี่ในการสแกนหาหุ้นใหม่ทั้งตลาด (มิลลิวินาที) เช่น 60000 = ทุก 1 นาที
POLL_MS=60000

# ระยะเวลาห้ามส่งสัญญาณซ้ำสำหรับหุ้น/timeframe เดียวกัน (มิลลิวินาที) เช่น 900000 = 15 นาที
COOLDOWN_MS=900000

# ช่วงเวลาที่ให้โปรแกรมทำงาน: regular (09:30-16:00 ET) / extended (04:00-20:00 ET) / always (ทำงานตลอดเวลา ใช้ทดสอบ)
SESSION=regular

# โหมดทดสอบ (true = ไม่ส่ง LINE จริง แค่พิมพ์ให้ดูในหน้าจอ) — ปกติสั่งผ่านคำสั่ง npm run dry ไม่ต้องแก้ตรงนี้ก็ได้
DRY_RUN=false

# ═══════════════════════════════════════════════════════════════
# ค่าที่เพิ่มมาในเวอร์ชัน Web App (ทุกตัวมีค่า default อยู่แล้ว ไม่ใส่ก็ได้)
# หมายเหตุ: ค่าที่แก้ในหน้า Settings จะถูกบันทึกลง data/settings.json
#          ซึ่งมีลำดับความสำคัญ "สูงกว่า" ไฟล์นี้
# ═══════════════════════════════════════════════════════════════

# ---------- API keys ของแหล่งข้อมูลหลายชั้น (free tier ทั้งหมด) ----------
# ไม่ใส่ตัวไหน = ระบบข้าม provider นั้นไปเลย ไม่ crash
# กรอกผ่านหน้า Settings ก็ได้ ไม่ต้องแก้ไฟล์นี้

# Finnhub — ราคา realtime หลัก + ปฏิทินงบ + ข่าว (ฟรี 60 ครั้ง/นาที)
# ขอที่ https://finnhub.io/register
# ⚠️ free tier ไม่ให้แท่งเทียน (/stock/candle เป็น premium) ระบบจึงใช้ Yahoo สำหรับแท่งเทียน
FINNHUB_API_KEY=

# Twelve Data — สำรองราคา + แท่งเทียน (ฟรี 8 credits/นาที, 800/วัน)
# ขอที่ https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# Alpha Vantage — คะแนน sentiment เป็นตัวเลขจริง (ฟรี 25 ครั้ง/วัน เท่านั้น)
# ขอที่ https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Marketaux — ข่าว + sentiment (โควตากว้างกว่า Alpha Vantage)
# ขอที่ https://www.marketaux.com/register
MARKETAUX_API_KEY=

# Financial Modeling Prep — float + short interest (ฟรี 250 ครั้ง/วัน)
# ขอที่ https://site.financialmodelingprep.com/developer/docs
# อาจไม่อยู่ใน free tier แล้ว ระบบจะข้ามให้เองถ้าใช้ไม่ได้
FMP_API_KEY=

# ---------- โหมดข้อมูลจำลอง ----------
# true = ใช้ข้อมูลสังเคราะห์ ไม่ต่ออินเทอร์เน็ต (ลองหน้าเว็บตอนตลาดปิดได้)
# หรือใช้คำสั่ง npm run demo ซึ่งเปิดโหมดนี้ให้อัตโนมัติ
MOCK_DATA=false

# ---------- port ของ web server ----------
PORT=3000

# ---------- ความเสี่ยง / จุดตัดขาดทุน ----------
# ⚠️ ATR_STOP_MULT default เปลี่ยนจาก 1.5 → 1.0
# เพราะ 1.5 เป็นค่าแบบ day trade ทำให้ stop กว้างเกินไปสำหรับ scalping
# และทำให้ R:R ไม่มีทางถึง 1:1.5 (ดูคำอธิบายเต็มใน src/scoring.js)
ATR_STOP_MULT=1.0
MIN_STOP_ATR=0.35
TARGET_EXT_ATR=0.5
MIN_RR=1.5

# ---------- แนวต้าน / ราคาเป้าหมายแจ้งเตือน ----------
ALERT_OFFSET_PCT=0.1
PIVOT_K=2
CLUSTER_ATR_MULT=0.25

# ---------- น้ำหนักคะแนน 6 ปัจจัย (รวมต้องได้ 100) ----------
W_RVOL=25
W_VOLATILITY=20
W_RESISTANCE=15
W_MOMENTUM=15
W_SENTIMENT=15
W_LIQUIDITY=10
RENORMALIZE_WEIGHTS=false
SIGNAL_SCORE=70

# ---------- ช่วงความผันผวนที่เหมาะกับ scalping (%/วัน) ----------
ATR_PCT_LOW=1.5
ATR_PCT_HIGH=3.0

# ---------- universe ----------
USE_AUTO_SCREENER=true
UNIVERSE_SIZE=30

# ---------- sentiment ----------
NEWS_PROVIDER_ORDER=alphavantage,marketaux,finnhub
SENTIMENT_TOP_N=3

# ---------- LINE (ช่องเสริม) ----------
# false = ไม่ส่ง LINE (ใช้แจ้งเตือนบนหน้าเว็บอย่างเดียว)
LINE_ENABLED=false

# ---------- ซ่อนแถวที่คะแนนต่ำ (ค่าใหม่) ----------
# 0 = แสดงทุกตัวในตาราง (แนะนำ — จะเห็นว่าหุ้นแต่ละตัวได้คะแนนเท่าไหร่และตกเพราะอะไร)
# ⚠️ อย่าสับสนกับ MIN_SCORE ด้านบน:
#    MIN_SCORE / SIGNAL_SCORE = คะแนนที่ถือว่าเป็น "สัญญาณ" (แสดงในตารางแต่ไม่ติดป้ายสัญญาณ)
#    HIDE_BELOW_SCORE         = ซ่อนออกจากตารางเลย
HIDE_BELOW_SCORE=0

# ---------- ค่าที่เพิ่มให้ตรงกับ setup-env.js ----------
# true = สแกนต่อแม้ตลาดปิด (เห็นราคาล่าสุดก่อนปิด)
# false = ข้ามรอบไปเลยเมื่ออยู่นอกช่วง session ประหยัดโควตา API
SCAN_WHEN_CLOSED=true

# ═══════════════════════════════════════════════════════════════════════
#  ★ v2 — ค่าที่เพิ่มเข้ามาเพื่อแก้อาการ "ตอบรับช้า · กำไรต่อไม้น้อย"
#  ทุกค่าด้านล่างแก้ผ่านหน้า Settings ได้ ไม่ต้องแตะไฟล์นี้
#  ไฟล์นี้มีไว้เผื่อคุณอยากตั้งค่าเริ่มต้นก่อนเปิดโปรแกรมครั้งแรก
# ═══════════════════════════════════════════════════════════════════════

# ---------- หน่วยของไม้ (ตัวที่กำหนดว่ากำไรต่อไม้จะใหญ่แค่ไหน) ----------
# v1 วัด stop และเป้าด้วย ATR ของแท่ง 5 นาที ซึ่งเล็กมาก
# ตัวอย่างจริงจาก data/signals-history.json: AAPL @ $171.65 ได้ stop $0.36 = 0.21% ของราคา
# ทั้งไม้จึงกินพื้นที่แค่ 0.2-0.6% ซึ่งอยู่ในสัญญาณรบกวนของแท่งเดียว และ spread กินกำไรไป 15%
# daily    = วัดด้วย ATR รายวัน (แนะนำ) — ยืดกรอบเวลาของไม้จาก "นาที" เป็น "ชั่วโมงถึงวัน"
# intraday = พฤติกรรมแบบ v1
TRADE_ATR_BASIS=daily
STOP_ATR_DAILY=0.35
TARGET_ATR_DAILY=1.2
MIN_STOP_PCT=0.6
# ต้นทุนไป-กลับนอกเหนือจาก spread (คอมมิชชัน + slippage) — ระบบบวก spread จริงเข้าไปอีก
# แล้วหักออกจากกำไรก่อนคิด R:R → ไม้ที่ต้นทุนกินหมดจะตกตัวกรอง R:R เอง
COST_PCT=0.10
# เป้าต้องห่างจากราคาเข้าอย่างน้อยกี่ % (ถึง R:R จะสวย ถ้าเป้าห่างแค่ 0.3% ก็คือเล่นในสัญญาณรบกวน)
MIN_TARGET_MOVE_PCT=0.8

# ---------- ด่านแนวโน้มระยะกลาง (Trend Template แบบ Minervini) ----------
# ต้องมีแท่งรายวัน ~200 แท่ง ถ้า provider ให้ไม่พอ ระบบจะข้ามด่านนี้และติดคำเตือน ไม่ตัดหุ้นทิ้ง
REQUIRE_TREND_TEMPLATE=true
MIN_TREND_CHECKS=5
MIN_RS_SCORE=60
RS_BENCHMARK=SPY
# อยู่ใต้ VWAP = คนที่ซื้อวันนี้ส่วนใหญ่ติดดอย ทุกการเด้งจะเจอแรงขายรอเท่าทุน
REQUIRE_ABOVE_VWAP=true

# ---------- จังหวะเข้าไม้ ----------
# confirm    = รอราคาทะลุแนวต้านจริงพร้อมวอลุ่มยืนยัน (แนะนำ)
# anticipate = เข้าก่อนแนวต้านที่ ×0.999 แบบ v1 (แผนงาน v1 เขียนเองว่า "ประมาณครึ่งหนึ่งจะเด้งกลับ")
ENTRY_MODE=confirm
CONFIRM_OFFSET_PCT=0.05
BREAKOUT_RVOL_MIN=1.5

# ---------- การจัดการไม้ที่เปิดอยู่ (ข้อ P1 ที่ค้างจาก v1) ----------
# ระบบเป็นสมุดบันทึก ไม่ได้ส่งคำสั่งซื้อขายจริงและไม่เชื่อมโบรกเกอร์
TRACK_TRADES=true
MAX_OPEN_TRADES=4
DAILY_LOSS_LIMIT_R=3
TP1_R=1.0
TP1_PCT=50
BREAKEVEN_AFTER_TP1=true
TRAIL_ATR_MULT=2.0
TIME_STOP_MIN=45
EXIT_ON_EMA_LOST=true
EXIT_ON_VWAP_LOST=true
# false = ถึงเป้าแล้วไม่ออก ใช้ trailing stop พาออกแทน — ที่มาของกำไรก้อนใหญ่
EXIT_AT_TARGET=false
# วิธีของ Livermore: เติมเฉพาะไม้ที่พิสูจน์ตัวเองแล้ว โดยความเสี่ยงรวมไม่เกิน 1R เดิม
PYRAMID_ENABLED=true
PYRAMID_MIN_R=1.0
PYRAMID_MAX_ADDS=2

# ---------- ความเร็ว ----------
# v1 วิเคราะห์เรียงทีละตัว หุ้น 30 ตัว × 2 timeframe มักใช้เวลานานกว่ารอบ 60 วินาทีที่ตั้งไว้
SCAN_CONCURRENCY=5
# ยิงเฉพาะ "ราคา" ของไม้ที่ถืออยู่และหุ้นที่จ่อระดับเบรก · 0 = ปิด
# ต่ำกว่า 20 ไม่ได้ผล เพราะ cache ของราคาคือ 20 วินาที
HOT_POLL_SEC=20
HOT_DISTANCE_ATR=0.6

# ---------- ★ v2.1: ค่าเงิน (USD/THB) ----------
# คะแนนบอกว่าเรตวันนี้ถูก/แพงแค่ไหนเทียบกับปีที่ผ่านมา — ไม่ใช่การพยากรณ์ว่าพรุ่งนี้จะขึ้นหรือลง
# อัตราแลกเปลี่ยนเคลื่อนไหวใกล้เคียงการสุ่ม การอยู่จุดต่ำสุดของปีไม่ได้แปลว่าจะเด้งขึ้น
# แต่ถ้าคุณต้องแลกอยู่แล้ว คำถามคือ "แลกวันไหนดีในช่วงที่มีให้เลือก" ซึ่งคะแนนนี้ตอบได้
FX_ENABLED=true
FX_PAIR=USD/THB
# ★ เฝ้าดูหลายสกุลพร้อมกัน (สูงสุด 8 คู่ · คู่แรกคือคู่หลัก) — เพิ่ม/ลบจากการ์ดค่าเงินในแดชบอร์ดได้ด้วย
# สกุลที่ Yahoo ไม่มีประวัติเทียบบาทตรงๆ (เช่น CNY, VND, PHP, AED) ระบบคำนวณผ่าน USD ให้เอง
# FX_PAIRS=USD/THB,EUR/THB,JPY/THB,CNY/THB
# ตรวจทุก 15 นาที โดยอิสระจากการสแกนหุ้น (กด Stop Scanner แล้วค่าเงินยังถูกเฝ้าอยู่)
FX_POLL_SEC=900
FX_LOOKBACK_DAYS=365
# ส่วนต่างธนาคาร/ร้านแลกเงิน — เรตจาก provider เป็นเรตกลางตลาดที่ไม่มีใครได้จริง
# ธนาคารไทยราว 0.3-0.8% · ร้านแลกเงินแคบกว่า · ตั้งให้ตรงกับที่คุณใช้จริง
FX_SPREAD_PCT=0.5
FX_SCORE_THRESHOLD=75
FX_ALERT_BUY=true
FX_ALERT_SELL=true
# เรตเป้าที่ตั้งเอง · 0 = ไม่ใช้ ให้ดูจากคะแนนอย่างเดียว
# เป้าซื้อควรต่ำกว่าเป้าขาย ไม่งั้นช่วงทับกันแล้วเตือนทั้งสองทางพร้อมกัน
FX_BUY_BELOW=0
FX_SELL_ABOVE=0
# จำนวนที่ตั้งใจจะแลก — ใช้แปลงคะแนนเป็น "ต่างจากค่าเฉลี่ยกี่บาท" ซึ่งมีความหมายกว่าคะแนน
FX_BUY_AMOUNT_THB=100000
FX_SELL_AMOUNT_USD=3000

# ---------- รหัสผ่านหน้าเว็บ ----------
# ตั้งเมื่อเอาขึ้นเว็บจริง (Render/Railway) — ว่างไว้ = ไม่ต้องใส่รหัส (ใช้ในเครื่องตัวเอง)
# browser จะเด้งช่องให้กรอก: username ใส่อะไรก็ได้ · password ใส่ค่านี้
APP_PASSWORD=
